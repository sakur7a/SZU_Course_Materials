йтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтсйтс